# Variables de PRODUCCIÓN (docker-compose.prod.yml). Copia este archivo como .env.prod
# en el servidor y cambia TODOS los valores "cambia-esto". .env.prod NUNCA va al repositorio.
# Con NODE_ENV=production el backend se niega a arrancar si encuentra un valor de ejemplo.
#
# Para generar claves largas y aleatorias:  openssl rand -base64 48

# Dominio público (el DNS debe apuntar a la IP del servidor). Para probar en tu PC: localhost
DOMINIO=hallazgo.ejemplo.edu.co

# Base de datos (no se publica: solo la ven los contenedores)
POSTGRES_USER=hallazgo
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
POSTGRES_DB=hallazgo_ud
# Clave del rol hallazgo_app, con el que se conecta el backend (permisos mínimos)
CLAVE_APP_BD=cambia-esto-por-otra-clave-larga

# Sesiones
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio-de-64-caracteres
JWT_EXPIRA_EN=1d
BCRYPT_COSTE=12
DOMINIO_CORREO=udistrital.edu.co

# Correo saliente: un SMTP REAL (Brevo, Amazon SES, el de la universidad…)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
# Entre comillas: los signos < > confunden a bash al leer este archivo (respaldar.sh)
SMTP_FROM="HallazGO UD <no-responder@hallazgo.ejemplo.edu.co>"
SMTP_USUARIO=
SMTP_CLAVE=

# Almacenamiento de imágenes (SeaweedFS dentro del servidor)
S3_BUCKET=hallazgo-imagenes
S3_ACCESS_KEY=cambia-esto-llave-s3
S3_SECRET_KEY=cambia-esto-por-otro-valor-largo

# Respaldos (infra/respaldo/respaldar.sh)
COMPOSE_FILE=docker-compose.prod.yml
DIAS_RETENCION_RESPALDO=30

# Puertos públicos de Caddy (en el servidor, 80 y 443; cámbialos solo para probar en un PC)
PUERTO_HTTP=80
PUERTO_HTTPS=443
