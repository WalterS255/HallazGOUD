# Copia este archivo a .env y cambia los valores. .env NUNCA se sube al repositorio.

# Base de datos (docker-compose y backend)
POSTGRES_USER=hallazgo
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=hallazgo_ud
# Si ya tienes PostgreSQL instalado en tu PC usando el 5432, usa 5433 aquí y en DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hallazgo:cambia-esta-contrasena@localhost:5432/hallazgo_ud

# Autenticación
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRA_EN=1d
BCRYPT_COSTE=12

# Dominio permitido para el registro
DOMINIO_CORREO=udistrital.edu.co

# Correo (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="HallazGO UD <no-responder@hallazgo.local>"

# Almacenamiento de imágenes (pendiente: MinIO ya no publica imágenes Docker gratuitas)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hallazgo-imagenes
S3_ACCESS_KEY=cambia-esto
S3_SECRET_KEY=cambia-esto

# App
PUERTO=3000
URL_FRONTEND=http://localhost:5173
ZONA_HORARIA=America/Bogota
