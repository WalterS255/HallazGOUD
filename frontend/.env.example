# Copia este archivo como frontend/.env

# Dirección del backend (sin /api al final). En desarrollo, el backend de este repositorio.
BACKEND_URL=http://localhost:3000

# Prefijo de las rutas de la API (el backend usa setGlobalPrefix('api'))
BACKEND_API_PREFIX=/api

# Dominio permitido en el registro (sólo para mostrarlo en el formulario; la regla la aplica el backend)
DOMINIO_CORREO=udistrital.edu.co
