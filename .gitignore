# Secretos: NUNCA al repositorio (solo .env.example)
.env
.env.*
!.env.example

# Dependencias y compilados
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
# Cliente de Prisma: se genera con `prisma generate` (lo hace solo el postinstall)
backend/src/generated/

# Logs
*.log
npm-debug.log*

# Editores y sistema operativo
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Prueba de carga (k6): resultado de cada corrida
infra/carga/resultado.json
# Informes de OWASP ZAP: se regeneran con los comandos de infra/seguridad/README.md
infra/seguridad/informes/

# Pruebas E2E (Playwright)
playwright-report/
frontend/e2e/.auth/
test-results/

# Respaldos de la BD: contienen datos personales, nunca al repositorio
respaldos/
